; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ktun"
run/main_scene="uid://d0bdje052hqbl"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://resources/Icon.svg"

[audio]

buses/default_bus_layout="uid://ca4vuh3ch3yrf"
general/3d_panning_strength=1.0

[autoload]

di_initializer="*res://scenes/di_initializer.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="ktun"

[editor_plugins]

enabled=PackedStringArray("res://addons/interface_export/plugin.cfg", "res://addons/raytraced_audio/plugin.cfg", "res://addons/window_ids/plugin.cfg")

[file_customization]

folder_colors={
"res://resources/": "orange",
"res://scenes/": "pink",
"res://scripts/": "purple"
}

